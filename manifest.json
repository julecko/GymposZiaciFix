{
    "manifest_version": 3,
    "name": "Gympos Ziaci Fix",
    "version": "1.0",
    "description": "Redirects /ziaci to /studenti on gympos.sk subdomains with toggle option.",
    "permissions": ["declarativeNetRequest", "storage"],
    "host_permissions": ["https://*.gympos.sk/*"],
    "action": {
        "default_title": "Gympos Redirector",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "declarative_net_request": {
        "rule_resources": [{
            "id": "redirect-ziaci",
            "enabled": true,
            "path": "rules.json"
        }]
    },
    "content_scripts": [
        {
            "matches": ["https://*.gympos.sk/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "background": {
      "service_worker": "background.js"
    }
}